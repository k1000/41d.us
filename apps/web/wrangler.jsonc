{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "j01n-me",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "j01n.me",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDEZVOUS",
        "class_name": "RendezvousSession"
      },
      {
        "name": "ROOM_REGISTRY",
        "class_name": "RoomRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RendezvousSession"]
    },
    {
      "tag": "v2-room-registry",
      "new_sqlite_classes": ["RoomRegistry"]
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
