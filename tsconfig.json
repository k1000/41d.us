{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@41d/sdk": ["./packages/sdk/src/sdk.ts"],
      "@41d/sdk/crypto": ["./packages/sdk/src/crypto.ts"],
      "@41d/sdk/crypto-session": ["./packages/sdk/src/sdk-crypto-session.ts"],
      "@41d/sdk/types": ["./packages/sdk/src/types.ts"],
      "@41d/helper/client-script": ["./packages/helper/src/client-script.ts"],
      "@41d/helper/local-crypto-assets": ["./packages/helper/src/local-crypto-assets.ts"],
      "@41d/skill": ["./packages/skill/src/skill.ts"],
      "@41d/mcp-server": ["./packages/mcp-server/src/index.ts"]
    }
  },
  "include": ["apps/web/src/**/*.ts", "apps/web/test/**/*.ts", "packages/helper/**/*.ts", "packages/sdk/**/*.ts", "packages/skill/**/*.ts", "packages/mcp-server/**/*.ts"]
}
